{
  "driver": "LlmOpenAI",
  "var": "llm0",

  "endpoint": "https://moma.cmecloud.cn/v1/chat/completions",
  "model": "zhipu/glm-5.3-flash",

  "api_key": "sk-REPLACE-ME",
  "api_key_file": "",

  "timeout": 180,
  "max_tokens": 4096,
  "temperature": 0.7,
  "top_p": 0.9,

  "reasoning_effort": "",
  "thinking": "",

  "max_turns": 8,
  "max_task_seconds": 900,
  "scripts_dir": "scripts",
  "allow_shell": false,

  "prompt_files": [],
  "camera_var": "cam0",
  "camera_device": "",
  "camera_src": "",
  "allow_camera": true,

  "audit_log": "",
  "agent_policy": "",

  "max_history_bytes": 4194304,
  "max_task_tool_result_bytes": 2097152,
  "max_task_image_bytes": 4194304,

  "max_calls_per_round": 16,
  "max_retries": 3,
  "retry_backoff_ms": 1000,
  "run_command_timeout_sec": 10,
  "run_command_max_timeout_sec": 60,

  // 动作脚本执行预算（秒）。run_action_script 是唯一曾无上界的执行路径：
  // 动作脚本本身是线性矩阵、DSL 无循环，挂死只可能来自 Lua 驱动自己的 call()
  // （死循环或阻塞在系统调用里）。超期即以「预算耗尽」中止本轮脚本并回传给模型。
  // 0 = 显式关闭预算（危险：会话可能永久卡住）。上限 3600，缺省 180。
  "action_script_timeout_sec": 180
}
